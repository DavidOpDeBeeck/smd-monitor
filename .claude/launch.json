{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "monitor-hub-demo",
      "runtimeExecutable": ".\\gradlew.bat",
      "runtimeArgs": ["demo"],
      "port": 8080,
      "url": "http://127.0.0.1:8080"
    },
    {
      "name": "monitor-ui-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "benchmarks-page",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "python3 -I docs/benchmarks/benchmarks.py page && exec python3 -I -m http.server 8765 --bind 0.0.0.0 --directory build/benchmarks"],
      "port": 8765,
      "url": "http://127.0.0.1:8765/page.html"
    }
  ]
}
